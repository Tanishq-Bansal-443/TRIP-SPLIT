# PostgreSQL connection string (Prisma)
# Local example: postgresql://postgres:postgres@localhost:5432/tripsplit?schema=public
# Vercel / Neon / Supabase example: postgres://default:...@ep-...pooler.us-east-1.postgres.vercel-storage.com/verceldb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tripsplit?schema=public"

# Session encryption secret (minimum 32 characters)
SESSION_SECRET="replace-with-a-secure-random-32-char-string-in-production-12345"

# Next.js app URL (optional in production, used for invite link generation)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
